<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Causa.Engine</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="EchelonFoundry.Aegis.Core" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Operational.fs" />
    <Compile Include="Routes.fs" />
    <Compile Include="Schemas.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../contract/Causa.Contract.fsproj" />
    <ProjectReference Include="../domain/Causa.Domain.fsproj" />
  </ItemGroup>
</Project>
